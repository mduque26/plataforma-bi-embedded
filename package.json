{
  "name": "shipbi-white-label",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=seed.sql",
    "db:validate": "node scripts/validate-schema.mjs",
    "setup": "npm run db:migrate && npm run db:seed",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.111.0"
  },
  "dependencies": {
    "material-symbols": "^0.47.5",
    "powerbi-client": "^2.23.1"
  }
}
